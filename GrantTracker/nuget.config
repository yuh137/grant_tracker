<?xml version="1.0" encoding="utf-8"?>
<!-- Pin restore to nuget.org so the solution restores identically on any machine, regardless of user-level feeds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
